<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>assets\ClipHarbor.ico</ApplicationIcon>
    <AssemblyName>ClipHarbor</AssemblyName>
    <RootNamespace>ClipHarbor</RootNamespace>
    <Product>ClipHarbor</Product>
    <Version>1.0.0</Version>
    <Description>Free, open-source video and audio downloader.</Description>
    <Copyright>Copyright (c) 2026 ClipHarbor contributors</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <NoWarn>$(NoWarn);WFO1000;CA1416</NoWarn>
  </PropertyGroup>

</Project>
